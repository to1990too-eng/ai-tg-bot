# ==== Telegram ====
BOT_TOKEN=123456:PUT_REAL_TOKEN_HERE

# ==== Postgres ====
POSTGRES_HOST=localhost
POSTGRES_PORT=5432
POSTGRES_USER=bot
POSTGRES_PASSWORD=bot
POSTGRES_DB=bot

# ==== Redis ====
REDIS_HOST=localhost
REDIS_PORT=6379
REDIS_DB=0

# ==== AI Providers ====
OPENAI_API_KEY=sk-...
OPENAI_BASE_URL=https://api.openai.com/v1
DEFAULT_PROVIDER=echo

# ==== App ====
LOG_LEVEL=INFO
ENV=dev

# ==== Billing ====
# Сколько единиц баланса списываем за 1 генерацию (MVP: плоский тариф)
PRICE_PER_GENERATION=1
START_BALANCE=10